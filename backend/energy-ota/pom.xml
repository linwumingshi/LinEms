<?xml version="1.0" encoding="UTF-8"?>
<!--
  energy-ota：OTA 固件升级中心（Phase 12）
  - 升级包管理（ota_package）：全量包 + 差分包（bsdiff），MD5/SHA256 校验 + RSA 签名（预留）
  - 批次升级任务（ota_task / ota_task_device）：设备快照、灰度 1-10-50-100、重试/超时扫描
  - 设备协议：ota/inform·progress·result·pull 上行，{pk}/{dn}/ota/down 下行（复用 Kafka 总线）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.energyx</groupId>
    <artifactId>energy-ems-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>energy-ota</artifactId>
  <name>energy-ota</name>
  <description>OTA 固件升级中心：升级包管理 / 批次任务 / 灰度发布 / 差分升级</description>

  <properties>
    <!-- 本地仓库仅有 micrometer 1.13.4 全系列，覆盖 Boot 3.5.4 BOM 管理的 1.15.2 保持离线可构建 -->
    <micrometer.version>1.13.4</micrometer.version>
    <prometheus-client.version>1.2.1</prometheus-client.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.energyx</groupId>
      <artifactId>energy-common</artifactId>
    </dependency>

    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Kafka 走原生 kafka-clients（镜像缺失 spring-boot-starter-kafka，Phase 3 D9 约定；
         OTA 上下行复用项目 Kafka 总线） -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.6.2</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 跨服务集成（device 版本回写等） -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 可观测性：actuator + Prometheus 指标端点 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.energyx.ota.OtaApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
