<?xml version="1.0" encoding="UTF-8"?>
<!--
  energy-rule：场景联动 / 规则编排（Phase 11）
  - TCA 模型（Trigger-Condition-Action），5 类触发源：PROPERTY/TIMER/LIFECYCLE/ALARM/MANUAL
  - 4 类动作：DEVICE_COMMAND（Feign 调命令中心）/ ALARM（调告警中心）/ NOTIFY（webhook）/ RULE（嵌套）
  - 消费 iot-thing-property / iot-device-lifecycle / iot-alarm（key=deviceId）
  - 定时触发走 xxl-job 调度中心（动态 job，jobKey=rule-{ruleId}，@XxlJob sceneRuleTimer）
  - 动作防抖 Redis SETNX（rule:debounce:*）+ 恢复边沿触发（rule:state:*）
  - 规则热更新：rule:changed pub/sub → 各实例增量刷新本地缓存
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.energyx</groupId>
    <artifactId>energy-ems-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>energy-rule</artifactId>
  <name>energy-rule</name>
  <description>场景联动与规则编排：TCA 规则引擎/触发匹配/条件求值/动作执行/执行日志</description>

  <properties>
    <!-- 本地仓库仅有 micrometer 1.13.4 全系列，覆盖 Boot 3.5.4 BOM 管理的 1.15.2 保持离线可构建 -->
    <micrometer.version>1.13.4</micrometer.version>
    <prometheus-client.version>1.2.1</prometheus-client.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.energyx</groupId>
      <artifactId>energy-common</artifactId>
    </dependency>

    <!-- xxl-job 执行器核心（定时触发，Phase 11 §10） -->
    <dependency>
      <groupId>com.xuxueli</groupId>
      <artifactId>xxl-job-core</artifactId>
    </dependency>

    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.6.2</version>
    </dependency>

    <!-- 动作 DEVICE_COMMAND 调命令中心 REST API（Feign + Nacos 服务名解析，同 energy-ems 模式） -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 可观测性：actuator + Prometheus 指标端点（O-01 业务服务指标管线） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.energyx.rule.RuleApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
