<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.sanduo</groupId>
  <artifactId>sanduo-stress</artifactId>
  <name>sanduo-stress</name>
  <version>1.0.0</version>
  <description>三多平台压测与演练工具：造数 / 连接压测 / 吞吐压测 / 控制链路 P99</description>
  <build>
    <finalName>stress</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.version}</version>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.sanduo.stress.StressCli</mainClass>
                </transformer>
                <transformer />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <jackson.version>2.15.4</jackson.version>
    <compiler.version>3.13.0</compiler.version>
    <maven.compiler.target>17</maven.compiler.target>
    <slf4j.version>2.0.13</slf4j.version>
    <sdk.version>1.0.0</sdk.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <logback.version>1.4.14</logback.version>
    <mysql.version>8.3.0</mysql.version>
    <shade.version>3.5.1</shade.version>
  </properties>
</project>
