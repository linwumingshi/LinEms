{
  "index_patterns": ["es-operator-log-*"],
  "template": {
    "settings": {
      "number_of_shards": 3,
      "number_of_replicas": 1,
      "index.lifecycle.name": "es_log_policy",
      "index.routing.allocation.require.data": "hot",
      "refresh_interval": "5s"
    },
    "aliases": {
      "es-operator-log": {}
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp":    { "type": "date" },
        "trace_id":      { "type": "keyword" },
        "tenant_id":     { "type": "long" },
        "operator_id":   { "type": "long" },
        "operator_name": { "type": "keyword" },
        "action":        { "type": "keyword" },
        "target_type":   { "type": "keyword" },
        "target_id":     { "type": "keyword" },
        "client_ip":     { "type": "ip" },
        "user_agent":    { "type": "keyword", "ignore_above": 256 },
        "detail":        { "type": "object", "enabled": true }
      }
    }
  }
}
