{
  "index_patterns": ["es-device-log-*"],
  "template": {
    "settings": {
      "number_of_shards": 3,
      "number_of_replicas": 1,
      "index.lifecycle.name": "es_log_policy",
      "index.routing.allocation.require.data": "hot",
      "index.mapping.total_fields.limit": 1000,
      "refresh_interval": "5s"
    },
    "aliases": {
      "es-device-log": {}
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp":    { "type": "date" },
        "trace_id":      { "type": "keyword" },
        "tenant_id":     { "type": "long" },
        "device_id":     { "type": "keyword" },
        "product_key":   { "type": "keyword" },
        "station_id":    { "type": "keyword" },
        "broker_node":   { "type": "keyword" },
        "client_ip":     { "type": "ip" },
        "level":         { "type": "keyword" },
        "code":          { "type": "keyword" },
        "message": {
          "type": "text",
          "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } }
        },
        "extra":         { "type": "object", "enabled": true }
      }
    }
  }
}
